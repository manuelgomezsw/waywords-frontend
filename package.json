{
  "name": "waywords-frontend",
  "version": "0.1.0",
  "description": "Angular 19 frontend for Waywords",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "echo 'Tests will be implemented in development'",
    "test:coverage": "echo 'Coverage will be implemented in development'",
    "e2e": "echo 'E2E tests will be implemented in development'",
    "lint": "echo 'ESLint will be configured in development'",
    "format:check": "echo 'Prettier will be configured in development'",
    "format:fix": "echo 'Prettier will be configured in development'",
    "audit:a11y": "echo 'Accessibility audit will be configured in development'",
    "analyze:bundle": "echo 'Bundle analysis will be configured in development'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
